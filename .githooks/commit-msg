#!/bin/sh
# 작업 브랜치(feat|fix|docs/ITD-####)의 커밋 제목을 `{종류}/ITD-#### 제목` 형식으로 강제하고 브랜치 티켓과 대조
# 보호 브랜치의 사람 커밋(초기 셋팅 등)과 병합·되돌리기 커밋은 검사하지 않음

msg_file=$1
title=$(grep -v '^#' "$msg_file" | sed -n '1p')
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

case "$title" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

printf '%s' "$branch" | grep -qE '^(feat|fix|docs)/ITD-[0-9]+$' || exit 0

if ! printf '%s' "$title" | grep -qE '^(feat|fix|docs)/ITD-[0-9]+ .+'; then
  echo "commit-msg: 제목 형식 위반. '{종류}/ITD-#### 제목' (예: $branch 사용자 조회 API 추가)" >&2
  exit 1
fi

prefix=${title%% *}
if [ "$prefix" != "$branch" ]; then
  echo "commit-msg: 제목의 '$prefix'가 현재 브랜치 '$branch'와 다름" >&2
  exit 1
fi

exit 0
